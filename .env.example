# Web
VITE_API_BASE_URL=/api/v1

# API
VIRAL_DNA_ENVIRONMENT=development
VIRAL_DNA_CORS_ORIGINS=http://127.0.0.1:4174,http://localhost:4174,http://localhost:5173
VIRAL_DNA_ANALYZER_MODE=hybrid
VIRAL_DNA_WORKSPACE_ROOT=./storage
# Legacy fallback retained for older installations and tests
VIRAL_DNA_STORAGE_ROOT=./storage
VIRAL_DNA_STORE=sqlite
VIRAL_DNA_FFMPEG_PATH=ffmpeg
VIRAL_DNA_FFPROBE_PATH=ffprobe
VIRAL_DNA_SCENE_THRESHOLD=0.30
VIRAL_DNA_LINK_MAX_BYTES=524288000
VIRAL_DNA_LINK_SOCKET_TIMEOUT=20
VIRAL_DNA_LINK_RETRIES=2
# Platform connections are configured in the GUI. These optional paths override
# the device-local metadata and Windows-DPAPI secret locations.
VIRAL_DNA_PLATFORM_CONNECTIONS_PATH=
VIRAL_DNA_PLATFORM_SECRET_ROOT=
# Legacy single-file setting: imported once and split by platform when present.
VIRAL_DNA_YTDLP_COOKIE_FILE=
VIRAL_DNA_YTDLP_PROXY=

# Optional local speech and on-screen text recognition
VIRAL_DNA_ASR_PROVIDER=disabled
VIRAL_DNA_ASR_MODEL=base
VIRAL_DNA_ASR_DEVICE=cpu
VIRAL_DNA_ASR_COMPUTE_TYPE=int8
VIRAL_DNA_ASR_LANGUAGE=zh
VIRAL_DNA_ASR_MODEL_DIR=./storage/models/faster-whisper
VIRAL_DNA_OCR_PROVIDER=disabled
VIRAL_DNA_OCR_MODEL=pp-ocrv6-small
VIRAL_DNA_OCR_MIN_CONFIDENCE=0.60

# Optional provider-neutral VLM gateway (disabled keeps media evidence mode)
VIRAL_DNA_VLM_PROVIDER=disabled
VIRAL_DNA_VLM_MODEL_ALIAS=auto
VIRAL_DNA_MODEL_PROFILE=balanced
VIRAL_DNA_MODEL_CATALOG=
VIRAL_DNA_MODEL_PRICING=
VIRAL_DNA_MODEL_MAX_ATTEMPTS=2
VIRAL_DNA_MODEL_TIMEOUT_SECONDS=90

# Alibaba Cloud Model Studio / DashScope (China Beijing)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Image generation is disabled until saved and validated in the GUI.
VIRAL_DNA_IMAGE_GENERATION_ENABLED=false
VIRAL_DNA_IMAGE_EXECUTION_MODE=remote_api
VIRAL_DNA_IMAGE_REMOTE_PROVIDER=dashscope
VIRAL_DNA_IMAGE_REMOTE_MODEL_ALIAS=qwen_image_2_pro
DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIRAL_DNA_IMAGE_DEFAULT_CANDIDATES=1
VIRAL_DNA_IMAGE_LOCAL_ADAPTER_ID=viral_dna_json_v1
VIRAL_DNA_IMAGE_LOCAL_EXECUTABLE=
VIRAL_DNA_IMAGE_LOCAL_FIXED_ARGS=[]
VIRAL_DNA_IMAGE_LOCAL_TIMEOUT_SECONDS=300
VIRAL_DNA_IMAGE_LOCAL_CONCURRENCY=1
VIRAL_DNA_IMAGE_LOCAL_PROTOCOL_VERSION=viral-dna-image-tool/v1
VIRAL_DNA_IMAGE_LOCAL_COST_SOURCE=unknown
VIRAL_DNA_IMAGE_LOCAL_UNIT_COST_MICROS=
VIRAL_DNA_IMAGE_LOCAL_PROXY_MODE=system
VIRAL_DNA_IMAGE_LOCAL_PROXY_URL=
VIRAL_DNA_IMAGE_LOCAL_WINDOWS_SANDBOX_MODE=auto

# Future standalone text reasoning provider
VIRAL_DNA_LLM_PROVIDER=
VIRAL_DNA_LLM_MODEL=
