# Persistent paths: use the ACTUAL existing paths when migrating an installation.
# This file contains no credentials. Keep the real file outside the repository.
VIRAL_DNA_AUTH_MODE=password
VIRAL_DNA_ADMIN_CONSOLE_ENABLED=true
VIRAL_DNA_ACCOUNT_CATALOG_PATH=D:\ViralDNA\data\account-catalog.json
VIRAL_DNA_AUTH_DB_PATH=D:\ViralDNA\data\accounts.sqlite3
VIRAL_DNA_ACCOUNTS_ROOT=D:\ViralDNA\data\accounts
VIRAL_DNA_WORKSPACE_ROOT=D:\ViralDNA\data\legacy-workspace
VIRAL_DNA_PLATFORM_SECRET_ROOT=D:\ViralDNA\data\secrets
VIRAL_DNA_CORS_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:18080
