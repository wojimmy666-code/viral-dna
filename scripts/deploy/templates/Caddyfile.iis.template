{
    admin 127.0.0.1:@@ADMIN_PORT@@
    auto_https off
    storage file_system {
        root "@@CADDY_DATA@@"
    }
    servers {
        trusted_proxies static 127.0.0.1/32
        trusted_proxies_strict
    }
}

(viral_dna_site) {
    root * "@@WEB_ROOT@@"
    map {http.request.header.X-Forwarded-Host} {original_host} {
        "" {hostport}
        default {http.request.header.X-Forwarded-Host}
    }
    encode gzip
    route {
        header X-ViralDNA-Release "@@RELEASE_ID@@"
        @private path /.git* /.server* /.env* /storage/* /uploads/* /services/* /scripts/*
        respond @private 404
        handle /api/* {
            reverse_proxy 127.0.0.1:@@API_PORT@@ {
                header_up Host {original_host}
                flush_interval -1
            }
        }
        handle /health {
            reverse_proxy 127.0.0.1:@@API_PORT@@
        }
        @static path_regexp static \.[a-zA-Z0-9]{1,8}$
        handle @static {
            file_server
        }
        handle {
            try_files {path} /index.html
            file_server
        }
    }
}

# Accept the original Host if this IIS server already preserves it globally.
# Access is still restricted to the loopback bind, never a public listener.
http://:@@SITE_PORT@@ {
    bind 127.0.0.1
    import viral_dna_site
}

http://127.0.0.1:@@PROBE_PORT@@ {
    bind 127.0.0.1
    import viral_dna_site
}
