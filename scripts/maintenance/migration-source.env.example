# Offline account migration: paths only, no passwords or model credentials.
# Copy to a private file, replace these EXAMPLES with verified API paths.
# Both auth and catalog may be under the Windows user's LOCALAPPDATA directory.
VIRAL_DNA_AUTH_MODE=password
VIRAL_DNA_AUTH_DB_PATH=C:\Users\HUAWEI\AppData\Local\ViralDNA\accounts.sqlite3
VIRAL_DNA_ACCOUNT_CATALOG_PATH=C:\Users\HUAWEI\AppData\Local\ViralDNA\account-catalog.json
VIRAL_DNA_ACCOUNTS_ROOT=C:\Users\HUAWEI\AppData\Local\ViralDNA\accounts
