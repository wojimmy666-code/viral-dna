{
  "name": "viral-dna",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "check:design": "npm --workspace apps/web run check:design",
    "check:docs": "node scripts/checks/check-docs.mjs",
    "check:scripts": "node scripts/checks/check-scripts.mjs",
    "test:launcher": "node --test scripts/tests/managed-launcher.test.mjs scripts/tests/deploy-layout.test.mjs",
    "test:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tests/deploy-server.tests.ps1",
    "test:web": "npm --workspace apps/web run test"
  }
}
