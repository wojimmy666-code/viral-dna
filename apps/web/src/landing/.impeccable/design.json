  "components": [
    {
      "name": "主操作按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "首屏进入创作台链接；Phosphor regular ArrowRight 路径内联，样式包含源码中的响应式尺寸与悬停、焦点。",
      "html": "<a class=\"ds-primary\" href=\"/login?returnTo=%2Fprojects\">进入创作台<svg width=\"25\" height=\"25\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z\"/></svg></a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:62px;padding:14px 32px;border:1px solid transparent;border-radius:12px;background:#5b4df5;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:clamp(16px,1.3672vw,21px);font-weight:600;line-height:1.4;white-space:nowrap;text-decoration:none;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-primary:hover{background:#7165ff;}.ds-primary:focus-visible{outline:2px solid #7165ff;outline-offset:5px}@media(max-width:1150px){.ds-primary{min-height:54px;padding:12px 24px}}@media(max-width:820px){.ds-primary{padding:14px 16px;gap:10px;font-size:16px}}@media(max-width:480px){.ds-primary{padding-inline:12px;gap:8px}.ds-primary svg{width:18px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "次操作按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "首屏观看演示的样式预览；Phosphor fill Play 路径内联。原生弹窗行为由 HomePage.jsx 负责。",
      "html": "<div class=\"ds-secondary-surface\" style=\"display:inline-block;background:#100f12\"><button class=\"ds-secondary\" type=\"button\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M240,128a15.74,15.74,0,0,1-7.6,13.51L88.32,229.65a16,16,0,0,1-16.2.3A15.86,15.86,0,0,1,64,216.13V39.87a15.86,15.86,0,0,1,8.12-13.82,16,16,0,0,1,16.2.3L232.4,114.49A15.74,15.74,0,0,1,240,128Z\"/></svg>观看演示</button></div>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:62px;padding:14px 32px;border:1px solid #65646c;border-radius:12px;background:transparent;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:clamp(16px,1.3672vw,21px);font-weight:600;line-height:1.4;white-space:nowrap;text-decoration:none;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-secondary:hover{background:#1c1b20;border-color:#bcbcc2;}.ds-secondary:focus-visible{outline:2px solid #7165ff;outline-offset:5px}@media(max-width:1150px){.ds-secondary{min-height:54px;padding:12px 24px}}@media(max-width:820px){.ds-secondary{padding:14px 16px;gap:10px;font-size:16px}}@media(max-width:480px){.ds-secondary{padding-inline:12px;gap:8px}.ds-secondary svg{width:18px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "官网导航链接组",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "实际四项锚点；预览显示桌面链接组和手机展开态。品牌、登录入口与菜单开合见源组件。",
      "html": "<nav class=\"ds-nav\" aria-label=\"官网导航\"><a class=\"ds-nav-link\" href=\"#showcase\">作品案例</a><a class=\"ds-nav-link\" href=\"#workflow\">创作流程</a><a class=\"ds-nav-link\" href=\"#skills\">Skill</a><a class=\"ds-nav-link\" href=\"#team\">团队协作</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:clamp(24px,3.3854vw,52px);background:#100f12;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:16px;font-weight:400;line-height:1.65}.ds-nav-link{padding-block:10px;color:#bcbcc2;text-decoration:none}.ds-nav-link:hover{color:#f7f7f6}.ds-nav-link:focus-visible{outline:2px solid #7165ff;outline-offset:5px}@media(max-width:1150px){.ds-nav{gap:24px}}@media(max-width:820px){.ds-nav{flex-direction:column;align-items:stretch;gap:0;padding:12px 20px;border:1px solid #36353b;border-radius:12px}.ds-nav-link{padding-block:14px}}"
    },
    {
      "name": "演示场景选项",
      "kind": "chip",
      "refersTo": "scene-choice",
      "description": "原生演示中的三项分镜按钮，展示 pressed 与未选状态；源码没有额外 hover 变化，实际切图由 React 状态负责。",
      "html": "<div class=\"ds-scenes\" aria-label=\"选择演示分镜\"><button class=\"ds-scene\" type=\"button\" aria-pressed=\"true\">产品特写</button><button class=\"ds-scene\" type=\"button\" aria-pressed=\"false\">场景演绎</button><button class=\"ds-scene\" type=\"button\" aria-pressed=\"false\">运镜节奏</button></div>",
      "css": ".ds-scenes{display:flex;flex-wrap:wrap;gap:8px;background:#100f12}.ds-scene{background:transparent;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:16px;font-weight:600;padding:10px 16px;border:1px solid #36353b;border-radius:8px;cursor:pointer}.ds-scene:hover{color:#f7f7f6}.ds-scene[aria-pressed=\"true\"]{border-color:#7165ff;background:#1c1b20}.ds-scene:focus-visible{outline:2px solid #7165ff;outline-offset:5px}"
    },
    {
      "name": "协作示意卡文本片段",
      "kind": "card",
      "refersTo": "collaboration-card",
      "description": "从实际协作卡抽取标题、项目说明与真实性页脚；影像和成员行留在源组件。此片段是非交互内容，不添加虚构控件或 hover 状态。",
      "html": "<article class=\"ds-card\" aria-label=\"企业项目协作示意，非实际账户数据\"><div class=\"ds-card-heading\"><span>产品故事 · 团队项目</span><span class=\"ds-card-caption\">协作示意</span></div><div class=\"ds-card-project\"><p class=\"ds-card-copy\">共享项目</p><h3 class=\"ds-card-title\">一支关于质感的短片</h3><span class=\"ds-card-caption\">分镜、素材与创作记录，留在同一个项目。</span></div><div class=\"ds-card-footer\">示意状态 · 不读取真实成员或编辑锁</div></article>",
      "css": ".ds-card{border:1px solid #36353b;border-radius:12px;overflow:hidden;background:#1c1b20;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:16px;line-height:1.65}.ds-card-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 28px;border-bottom:1px solid #36353b}.ds-card-caption{color:#bcbcc2;font-size:14px}.ds-card-project{margin:28px}.ds-card-copy{margin:0;color:#bcbcc2}.ds-card-title{margin:6px 0 8px;font-size:clamp(16px,1.3672vw,21px);font-weight:600;line-height:1.4}.ds-card-footer{padding:18px 28px;border-top:1px solid #36353b;color:#bcbcc2;font-size:14px}@media(max-width:1150px){.ds-card-project{margin:22px}}@media(max-width:820px){.ds-card-heading{padding:18px 20px}.ds-card-project{margin:20px}.ds-card-title{font-size:17px}.ds-card-footer{padding-inline:20px}}"
    },
    {
      "name": "登录手机号输入",
      "kind": "input",
      "refersTo": "login-field",
      "description": "现行 48px 输入与 14px 标签；含原手机号约束、聚焦、禁用及自动填充样式，源码无独立输入 hover 变化。",
      "html": "<label class=\"ds-login-phone-label\" for=\"ds-login-phone\"><span>手机号</span><input class=\"ds-login-phone\" id=\"ds-login-phone\" name=\"username\" type=\"tel\" inputmode=\"numeric\" minlength=\"11\" maxlength=\"11\" pattern=\"1[3-9][0-9]{9}\" placeholder=\"11 位手机号\" title=\"手机号必须为 11 位中国大陆手机号\" autocomplete=\"username\" required /></label>",
      "css": ".ds-login-phone-label{display:flex;flex-direction:column;gap:8px;background:#1c1b20;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:14px;font-weight:500;line-height:1.5}.ds-login-phone{box-sizing:border-box;width:100%;min-width:0;height:48px;border:1px solid #36353b;border-radius:8px;padding:12px 14px;background:#100f12;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:16px;font-weight:400;line-height:1.5;caret-color:#7165ff}.ds-login-phone::placeholder{color:#bcbcc2;opacity:1}.ds-login-phone:focus-visible{outline:2px solid #7165ff;outline-offset:2px;border-color:#7165ff}.ds-login-phone:disabled{opacity:.7}.ds-login-phone:autofill{box-shadow:0 0 0 1000px #100f12 inset;-webkit-text-fill-color:#f7f7f6;caret-color:#7165ff}"
    },
    {
      "name": "登录密码与显示控件",
      "kind": "input",
      "refersTo": "login-password-toggle",
      "description": "默认隐藏密码的样式片段；44px 眼睛控件内嵌 2px，6px 圆角，Phosphor regular Eye 路径内联。实际显示／隐藏与清除由 PublicLoginForm.jsx 负责。",
      "html": "<div class=\"ds-login-password-field\"><label class=\"ds-login-password-label\" for=\"ds-login-password\">密码（至少 8 位）</label><div class=\"ds-login-password\"><input class=\"ds-login-password-input\" id=\"ds-login-password\" name=\"password\" type=\"password\" minlength=\"8\" autocomplete=\"current-password\" required /><button class=\"ds-login-eye\" type=\"button\" aria-label=\"显示密码\" aria-pressed=\"false\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z\"/></svg></button></div></div>",
      "css": ".ds-login-password-field{background:#1c1b20;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;line-height:1.5}.ds-login-password-label{font-size:14px;font-weight:500}.ds-login-password{position:relative;margin-top:8px}.ds-login-password-input{box-sizing:border-box;width:100%;min-width:0;height:48px;border:1px solid #36353b;border-radius:8px;padding:12px 14px;background:#100f12;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:16px;font-weight:400;line-height:1.5;caret-color:#7165ff}.ds-login-password-input::placeholder{color:#bcbcc2;opacity:1}.ds-login-password-input:focus-visible{outline:2px solid #7165ff;outline-offset:2px;border-color:#7165ff}.ds-login-password-input:disabled{opacity:.7}.ds-login-password-input:autofill{box-shadow:0 0 0 1000px #100f12 inset;-webkit-text-fill-color:#f7f7f6;caret-color:#7165ff}.ds-login-password-input{padding-right:54px}.ds-login-eye{position:absolute;inset:2px 2px 2px auto;display:grid;place-items:center;width:44px;padding:0;border:0;border-radius:6px;background:transparent;color:#bcbcc2;cursor:pointer}.ds-login-eye:hover{color:#f7f7f6;background:#1c1b20}.ds-login-eye:focus-visible{outline:2px solid #7165ff;outline-offset:5px}.ds-login-eye:disabled{opacity:.65;cursor:not-allowed}"
    },
    {
      "name": "登录提交按钮",
      "kind": "button",
      "refersTo": "login-submit",
      "description": "登录专用普通字号主操作；保留默认品牌紫，hover 白字对比度为 4.7083:1。最小高度 48px，实际约 48.39px；不改首页 hover。",
      "html": "<div class=\"ds-login-submit-surface\"><button class=\"ds-login-submit\" type=\"button\">登录并进入</button></div>",
      "css": ".ds-login-submit-surface{background:#1c1b20}.ds-login-submit{box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;width:100%;min-height:48px;margin-top:28px;padding:12px 20px;border:1px solid transparent;border-radius:8px;background:#5b4df5;color:#f7f7f6;font-family:\"Microsoft YaHei UI\",\"PingFang SC\",system-ui,sans-serif;font-size:16px;font-weight:600;line-height:1.4;white-space:nowrap;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-login-submit:hover{background:#6355f6}.ds-login-submit:focus-visible{outline:2px solid #7165ff;outline-offset:5px}.ds-login-submit:disabled{opacity:.65;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-login-submit{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "电影级创作片场 / 片场留白",
    "overview": "暖金侧光、玻璃、金属和岩石影像为官网建立片场气氛。深炭背景托住宽厚白字，既有紫色标志与主操作保持品牌识别，界面结构以留白和细线组织。\n\n本契约从 [HomePage.jsx](HomePage.jsx)、[home.css](home.css)、[LoginDialog.jsx](LoginDialog.jsx)、[PublicLoginForm.jsx](PublicLoginForm.jsx) 与 [login.css](login.css) 提取，适用于公开 `/` 及同一首页实例上的 `/login` 浮层。登录是用户批准的既有视觉世界窄扩展；后台、初始化、激活及工作台内重新登录继续沿用独立账户界面，工作台继续遵守 [Web 工作台设计契约](../../DESIGN.md)。首页构图与历史交付状态见[方向契约](../../../../.impeccable/homepage-brief.md)，登录本次证据见[验收记录](../../../../.impeccable/review/homepage-login/acceptance.md)，产品事实见 [PRODUCT.md](../../../../PRODUCT.md)；它们不扩大本文件的视觉作用域。",
    "keyCharacteristics": [
      "影像承担材质与暖色，紫色承担品牌与交互。",
      "本地中文展示字体、两行首屏标题、宽松区块间距。",
      "手机独立重排，示意标识与核心操作清楚可达。",
      "登录以深炭功能面板承接创作入口，保留首页的播放意图、位置与焦点。"
    ],
    "rules": [
      {
        "name": "The Image Color Rule",
        "body": "暖色和材质由实际影像承担，界面强调沿用品牌紫。",
        "section": "colors"
      },
      {
        "name": "The Two-Line Rule",
        "body": "首屏保留“看懂好视频，／把创意做成片。”两行关系；手机调整字号和结构，不挤压正文来维持桌面布局。",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** 将官网令牌限制在 landing 表面，保留浅色工作台的原有规范。",
      "**Do** 保留示意影像、分镜短片和协作状态的真实性说明，视频与封面使用同一公开来源。",
      "**Do** 维护手机可达操作、键盘焦点及减少动态效果下的手动切换。",
      "**Do** 保持登录专用悬停色、系统字体、原位状态与关闭后的完整状态恢复。"
    ],
    "donts": [
      "**Don't** 把 AI 示意素材描述为真实客户案例或真实账户记录；只有实际接入的视频才可描述为可播放短片。",
      "**Don't** 用装饰性渐变或 CSS 假材质替代已批准的摄影质感影像。",
      "**Don't** 将本地获准的原生分辨率例外当作未来素材质量标准；审批与机械门禁状态留在方向契约和验收记录中。"
    ]
  }
}
